NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters

# Google Cloud: enable Photos Picker API, configure OAuth web client and API key.
GOOGLE_CLIENT_ID=
GOOGLE_API_KEY=

# Meta app: configure Instagram API with Instagram Login and set this exact
# redirect URI in Business Login settings:
# APP_BASE_URL/api/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v24.0
